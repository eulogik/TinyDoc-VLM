{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eulogik.com/schemas/sroie-receipt-v1.json",
  "title": "SROIEReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "date", "address", "total"],
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Merchant / company name as printed on the receipt"
    },
    "date": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "description": "Receipt date, any common order (DD/MM/YYYY, YYYY-MM-DD, etc.)"
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "Merchant address as printed"
    },
    "total": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Grand total amount, numeric with optional currency symbol"
    },
    "evidence": {
      "type": "object",
      "description": "Optional per-field evidence (Phase 1+)",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
